{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\"",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(./AGENTS.md)",
      "Edit(./init.sh)",
      "Write(./init.sh)",
      "Edit(./claude-progress.md)",
      "Write(./claude-progress.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./specs/**)",
      "Edit(./.github/**)",
      "Edit(./.harness/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./scripts/**)",
      "Edit(./package-lock.json)",
      "Edit(./tsconfig.json)",
      "Edit(./eslint.config.js)",
      "Edit(./vite.config.ts)",
      "Edit(./vitest.config.ts)",
      "Edit(./playwright.config.ts)",
      "Write(./specs/**)",
      "Write(./scripts/**)",
      "Write(./.claude/hooks/**)",
      "Write(./.github/**)",
      "Write(./.harness/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ]
  }
}
